<?xml version="1.0" encoding="utf-8"?>
<!--
  このファイルを secrets.config にコピーし、value に生成した値を設定してください。
  secrets.config は .gitignore 済みで、リポジトリにはコミットされません。

  値の形式: <反復回数>$<ソルトBase64>$<ハッシュBase64>
    - 反復回数  : 100000 以上（未満は不正として拒否されます）
    - ソルト    : 16バイト以上のランダム値
    - ハッシュ  : PBKDF2-HMAC-SHA1 の派生鍵 32バイト以上

  生成方法は README.md の「管理者パスワード」節を参照してください。
  value が空・未設定・書式不正の場合、管理者削除機能は無効になります
  （誰のパスワードも受け付けません）。
-->
<appSettings>
  <add key="AdminPassword" value="" />
</appSettings>
