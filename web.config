<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!--
      【重要】コンパイル設定
      debug="false": 本番運用の既定値（検証時のみ true にしてください）
      targetFramework: サーバーの.NETバージョンに合わせます（通常4.5～4.8）
    -->
    <compilation debug="false" targetFramework="4.7">
      <assemblies>
        <!-- ここで System.DirectoryServices.AccountManagement を明示的に参照追加します -->
        <add assembly="System.DirectoryServices.AccountManagement, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>

    <!--
      【重要】認証・認可設定
      IISの設定に加え、ここでも強制力を働かせます。
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>
    -->

    <!-- エラー画面の設定（Off にするとブラウザにエラー詳細が出ます） -->
    <customErrors mode="RemoteOnly"/>

    <!--
      requestValidationMode="2.0":
        default.aspx の ValidateRequest="false" を有効にするために必要です。
        「10<20」のように "<" を含む投稿がエラーにならないようにするための設定で、
        投稿内容はサーバー側で HtmlEncode してから保存・出力しています。
      maxRequestLength: アップロード制限の緩和（念のため）
    -->
    <httpRuntime maxRequestLength="10240" requestValidationMode="2.0" />
  </system.web>
</configuration>
