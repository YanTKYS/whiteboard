<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- 
      【重要】コンパイル設定
      debug="true": エラー時に詳細を表示します（本番運用時はfalse推奨）
      targetFramework: サーバーの.NETバージョンに合わせます（通常4.5～4.8）
    -->
    <compilation debug="true" targetFramework="4.7">
      <assemblies>
        <!-- ここで System.DirectoryServices.AccountManagement を明示的に参照追加します -->
        <add assembly="System.DirectoryServices.AccountManagement, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>

    <!-- 
      【重要】認証・認可設定
      IISの設定に加え、ここでも強制力を働かせます。
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" /> 
    </authorization>
    -->

    <!-- エラー画面の設定（Offにするとブラウザにエラー詳細が出ます） -->
    <customErrors mode="Off"/>
    
    <!-- アップロード制限の緩和（念のため） -->
    <httpRuntime maxRequestLength="10240" /> 
  </system.web>
</configuration>