<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    【重要】管理者グループ
    管理者判定に使う AD グループ名は、このファイルには書かず、
    リポジトリ管理外の local.config に置きます（local.config.sample を参照）。
    file 属性は「あれば読む」ため、local.config が無くても起動はします。
    その場合、管理者削除機能だけが利用不可になります（fail-closed）。
    ※ IIS は既定で *.config への直接 HTTP アクセスを拒否します。
  -->
  <appSettings file="local.config" />

  <system.web>
    <!--
      【重要】コンパイル設定
      debug="false": 本番運用の既定値（検証時のみ true にしてください）
      targetFramework: サーバーの.NETバージョンに合わせます（通常4.5～4.8）
    -->
    <compilation debug="false" targetFramework="4.7">
      <assemblies>
        <!-- ここで System.DirectoryServices.AccountManagement を明示的に参照追加します -->
        <add assembly="System.DirectoryServices.AccountManagement, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>

    <!--
      【重要】認証・認可設定
      IIS 側の設定に加え、ここでも強制力を働かせます。
      匿名ユーザー（?）を明示的に拒否するため、IIS の匿名認証が誤って
      有効になっていても未認証アクセスは通りません。
    -->
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>

    <!--
      【重要】ソースファイルの文字コード
      fileEncoding は .aspx などのソースを読み込む際の文字コードです。
      既定値はサーバーの ANSI コードページ（日本語 Windows では Shift-JIS）のため、
      これを指定しないと UTF-8 の default.aspx が文字化け・コンパイルエラーになります。
      utf-8 を明示することで、リポジトリのファイルをそのまま配置できます。
      ※ 過去に Shift-JIS へ変換して配置していた場合は、default.aspx と
        web.config を必ずセットで差し替えてください。
    -->
    <globalization fileEncoding="utf-8" />

    <!-- エラー画面の設定（Off にするとブラウザにエラー詳細が出ます） -->
    <customErrors mode="RemoteOnly"/>

    <!--
      requestValidationMode="2.0":
        default.aspx の ValidateRequest="false" を有効にするために必要です。
        「10<20」のように "<" を含む投稿がエラーにならないようにするための設定です。
        投稿内容は平文で保存し、描画時にコンテキストに応じてエスケープします。
      maxRequestLength: アップロード制限の緩和（念のため）
    -->
    <httpRuntime maxRequestLength="10240" requestValidationMode="2.0" />
  </system.web>
</configuration>
